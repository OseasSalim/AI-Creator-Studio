# Backend — nunca use service role keys no frontend
API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
